<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PayloadDirectory Condition="'$(PayloadDirectory)' == ''">../x64/Release</PayloadDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DWrite.dll" />
    <None Remove="force-proxy.dll" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDirectory)/DWrite.dll" LogicalName="DiscordProxyInstaller.DWrite.dll" />
    <EmbeddedResource Include="$(PayloadDirectory)/force-proxy.dll" LogicalName="DiscordProxyInstaller.force-proxy.dll" />
  </ItemGroup>

</Project>
